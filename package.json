    "ingest": "node --disable-warning=ExperimentalWarning scripts/ingest.js",
    "snapshot": "node --disable-warning=ExperimentalWarning scripts/export-snapshot.js",
    "build:site": "node --disable-warning=ExperimentalWarning scripts/build-site.js"
  }
}
